"""Cross-platform backend traits for Flint Engine.

Game logic and render-graph code depend on these traits rather than OS-specific
sockets or device files, allowing native Wayland/ALSA/Pulse on Linux, headless
CI backends, and future Win32/Cocoa backends with zero C wrapper libraries.
"""
from flint.platform.input import InputState


trait WindowBackend(Movable):
    def initialize(mut self, width: Int, height: Int) -> Bool: ...
    def poll_events(mut self, mut input: InputState): ...
    def present_argb(mut self, pixels: List[UInt32], width: Int, height: Int): ...
    def toggle_fullscreen(mut self): ...
    def should_close(self) -> Bool: ...
    def framebuffer_size(self) -> Tuple[Int, Int]: ...
    def shutdown(mut self): ...


trait AudioBackend(Movable):
    def initialize(mut self) -> Bool: ...
    def trigger(mut self, clip_id: Int, pitch: Float32, gain: Float32): ...
    def set_ambient_drone(mut self, level: Float32): ...
    def pump(mut self, master_gain: Float32): ...
    def shutdown(mut self): ...
