        s += Float64(v)
    assert_true(abs(s - 2.4473050322849303) < 1e-4, "antialiased upsample sum " + String(s))
    assert_true(_close(up.data[(1 * 12 + 5) * 20 + 7], 0.21984007954597473, 2e-6))
    var g: List[Float32] = [1.0, 0.6216099858283997, -0.22720204293727875, -0.9040720462799072, -0.8967584371566772, -0.2107957899570465, 0.6346925497055054, 0.9998586177825928, 0.608351469039917, -0.2435436099767685, -0.9111302495002747, -0.8891912698745728, -0.19433064758777618, 0.6475961804389954, 0.9994346499443054, 0.5949206352233887, -0.2598170042037964, -0.9179304838180542, -0.8813730478286743, -0.1778087019920349, 0.6603167057037354, 0.9987280368804932, 0.581322431564331, -0.2760160267353058, -0.9244711995124817, -0.8733046054840088, -0.16123834252357483, 0.6728498339653015, 0.9977390766143799, 0.5675598382949829, -0.29213881492614746, -0.9307512640953064]
    var o = bicubic_grid(g, 4, 3, 5, 2, Float32(1.0 / ((3.0 + 0.1) / 4.0)), Float32(1.0 / ((5.0 + 0.1) / 4.0)))
    _all_close("bicubic position grid", o, [1.045601487159729, 0.616629421710968, 0.1327773779630661, -0.5640379786491394, -0.8018820285797119, -0.7825065851211548, -0.5413882732391357, 0.21155959367752075, 0.7165750861167908, 0.9840271472930908, 0.33198750019073486, -0.6238209009170532, -0.7770626544952393, -0.8185125589370728, -0.6494677066802979, 0.12207543849945068, 0.5051143169403076, 0.9339599013328552, 0.9435558319091797, 0.21865978837013245, -0.8217515349388123, -1.0022644996643066, -0.6217553019523621, 0.039435796439647675, 0.38082194328308105, 0.8490009903907776, 0.8530705571174622, 0.3811797499656677, -0.11093128472566605, -0.8325877785682678], 3e-6)
    print("  bilinear (both alignments), antialiased bilinear, bicubic position grid")


def _pattern() -> Rgb8:
    var img = Rgb8(31, 23)
    for y in range(23):
        for x in range(31):
            var k = (y * 31 + x) * 3
            img.rgb[k] = UInt8((x * 7 + y * 3) % 256)
            img.rgb[k + 1] = UInt8((x * x + y * 5) % 256)
            img.rgb[k + 2] = UInt8((x * y) % 256)
    return img^


def _sums(img: Rgb8) -> Tuple[Int, Int]:
    var s = 0
    var w = 0
    for i in range(len(img.rgb)):
        s += Int(img.rgb[i])
        w = (w + Int(img.rgb[i]) * i) % 1000003
    return (s, w)


def test_opencv() raises:
    var img = _pattern()
    var c = _sums(cv2_resize_cubic_u8(img, 47, 35))
    assert_equal(c[0], 565136)
    assert_equal(c[1], 617923)
    var a = _sums(cv2_resize_area_u8(img, 13, 10))
    assert_equal(a[0], 44644)
    assert_equal(a[1], 614255)
    var a2 = _sums(cv2_resize_area_u8(img, 15, 11))
    assert_equal(a2[0], 56658)
    assert_equal(a2[1], 478686)
    var p = Planar(3, 23, 31)
    for y in range(23):
        for x in range(31):
            for ch in range(3):
                p.data[(ch * 23 + y) * 31 + x] = Float32(Int(img.rgb[(y * 31 + x) * 3 + ch])) / 255.0
    var f = cv2_resize_cubic_f32(p, 47, 35)
    var s = 0.0
    for v in f.data:
        s += Float64(v)
    assert_true(abs(s - 2215.7690604659456) < 2e-3, "float cubic sum " + String(s))
    assert_true(_close(f.data[(1 * 35 + 17) * 47 + 23], 0.0941176488995552, 2e-6))
    print("  OpenCV INTER_CUBIC (u8 / float) and INTER_AREA bit-exact")


